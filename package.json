{
  "name": "handpress",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsx scripts/check.ts",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.13",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^1.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
