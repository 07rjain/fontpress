# Use the publishable and secret keys from the SAME Clerk application.
# The publishable key is embedded in the browser build; the secret stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated browser origins allowed in Clerk session tokens.
APP_ORIGINS=http://localhost:5173,http://localhost:8787,https://fontpress.vercel.app,https://fontpress.subdomain.wtf,https://handpress.subdomain.wtf

# Required for Vercel. Server only: never prefix the secret with VITE_ or NEXT_PUBLIC_.
# Run supabase/migrations/202611150001_handpress.sql in the Supabase SQL Editor first.
# Leave both blank to use SQLite for local development.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional; not used by this integration, which keeps Clerk sign-in:
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_JWKS_URL=

# Local Node-server settings; SQLite is never used on Vercel.
PORT=8787
DATA_DIR=./data
