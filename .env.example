# Use the publishable and secret keys from the SAME Clerk application.
# The publishable key is embedded in the browser build; the secret stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated browser origins allowed in Clerk session tokens.
# Set this to your real HTTPS origin in production, then restart the API.
APP_ORIGINS=http://localhost:5173,http://localhost:8787

# Server-side settings; defaults shown below.
PORT=8787
DATA_DIR=./data
